# Large model files (>10MB, downloaded separately — see README for links)
Content/Models/Asr/**/*.onnx
Content/Models/Asr/**/*.int8.onnx
Content/Models/Asr/**/*.model
Content/Models/Asr/**/*.vocab
Content/Models/Kws/**/*.onnx
Content/Models/Kws/**/*.int8.onnx
Content/Models/Kws/**/*.model

# Keep small text files
!Content/Models/**/*.txt
!Content/Models/**/*.phone
!Content/Models/**/README.md

# Keep VAD model (small, 208KB)
!Content/Models/Vad/

# Build artifacts
Binaries/
Intermediate/
